# Google AI Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
PROJECT_ID=your_gcp_project_id
LOCATION=us-central1

# Model Configuration
MODEL_NAME=gemini-2.0-flash-exp
TEMPERATURE=0.7
MAX_TOKENS=8192

# Observability
LOG_LEVEL=INFO
ENABLE_TRACING=true
ENABLE_METRICS=true

# Deployment
ENVIRONMENT=development  # development, staging, production
