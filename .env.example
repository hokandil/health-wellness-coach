# API Configuration
# Use BYTEZ_API_KEY for Bytez API access, or GOOGLE_API_KEY for direct Google API
BYTEZ_API_KEY=your_bytez_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Model Configuration
# Prefix with "bytez/" to use Bytez API (e.g., bytez/google/gemini-2.5-flash)
# Prefix with "google/" to use direct Google API (e.g., google/gemini-2.0-flash-exp)
MODEL_NAME=bytez/google/gemini-2.5-flash

# Model Parameters
TEMPERATURE=0.7
MAX_TOKENS=8192

# ADK Session Management
USE_PERSISTENT_SESSIONS=true
SESSION_DB_URL=sqlite:///data/sessions.db

# Observability
LOG_LEVEL=INFO
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_HEALTH_METRICS=true

# Jaeger Configuration
JAEGER_ENDPOINT=http://localhost:4317

# ADK Web UI
ADK_WEB_PORT=8080
ADK_WEB_HOST=localhost

# Deployment
ENVIRONMENT=development  # development, staging, production
