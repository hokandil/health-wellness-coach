{
  "evaluation_name": "Health Coach Evaluation",
  "description": "Automated evaluation test cases for the Health & Wellness Coach",
  "version": "1.0.0",
  "test_cases": [
    {
      "id": "nutrition_001",
      "domain": "nutrition",
      "input": "I'm a 30-year-old male, 180cm tall, 80kg. I want to lose weight. Calculate my daily calorie needs.",
      "expected_agent": "nutrition_specialist",
      "expected_tools": ["calculate_daily_calories"],
      "success_criteria": {
        "contains_calorie_number": true,
        "mentions_deficit": true,
        "provides_recommendation": true
      }
    },
    {
      "id": "nutrition_002",
      "domain": "nutrition",
      "input": "Create a 3-day meal plan for muscle gain. I'm 25, male, 75kg, very active.",
      "expected_agent": "nutrition_specialist",
      "expected_tools": ["calculate_daily_calories", "calculate_macro_targets", "generate_meal_plan"],
      "success_criteria": {
        "has_meal_plan": true,
        "includes_macros": true,
        "covers_multiple_days": true
      }
    },
    {
